{
    "schemaVersion": 1,
    "id": "additionalredstone",
    "version": "${version}",
    "name": "AdditionalRedstone",
    "description": "additional redstone mechanics, like logic gates and more",
    "authors": [
        "Buecher_wurm"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/additional-redstone",
        "sources": "https://github.com/tristankechlo/AdditionalRedstone",
        "issues": "https://github.com/tristankechlo/AdditionalRedstone/issues"
    },
    "license": "CC BY-NC-ND 4.0",
    "icon": "pack.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.tristankechlo.additionalredstone.FabricAdditionalRedstone"
        ],
        "client": [
            "com.tristankechlo.additionalredstone.FabricClientSetup"
        ],
        "jei_mod_plugin": [
            "com.tristankechlo.additionalredstone.jei.JustEnoughItemsPlugin"
        ]
    },
    "mixins": [
        "additionalredstone.mixins.json"
    ],
    "accessWidener": "additionalredstone.accesswidener",
    "depends": {
        "fabricloader": ">=${fabric_loader_min}",
        "fabric": "*",
        "minecraft": ">=${fabric_range_min_inclusive} <${fabric_range_max_exclusive}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/bhUaWhq",
                "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/additional-redstone",
                "modmenu.modrinth": "https://modrinth.com/mod/additional-redstone",
                "modmenu.wiki": "https://github.com/tristankechlo/AdditionalRedstone/wiki"
            }
        }
    }
}